# Copy to the REPO ROOT as .env on the server (never commit): cp infra/prod/.env.example .env
# Compose is run with --env-file ../../.env, see docs/DEPLOY-ORACLE.md.

# --- used by docker-compose itself ---
POSTGRES_PASSWORD=change-me-long-random
# Domain without https://. No domain yet? Use <ip-with-dashes>.sslip.io, e.g. 129-146-10-20.sslip.io
SITE_ADDRESS=129-146-10-20.sslip.io

# --- used by the backend ---
SEED_DEMO=1
LLM_PROVIDER=gemini
LLM_MAIN_MODEL=gemini-2.5-flash
LLM_SMALL_MODEL=gemini-2.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
