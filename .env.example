# Copy to .env at the repo root. Never commit .env.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://eduagent:eduagent@127.0.0.1:5433/eduagent
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SESSION_HOURS=12
COOKIE_SECURE=false

# LLM adapter: openai | anthropic | gemini | fake (fake = offline, deterministic; used by tests)
# Anthropic defaults when the model names are empty: claude-opus-5-5 (agents) / claude-haiku-5-5 (guards, router).
# OpenAI and Gemini need both model names set.
LLM_PROVIDER=fake
LLM_MAIN_MODEL=
LLM_SMALL_MODEL=
LLM_EFFORT=medium
# Embeddings: openai | gemini | fake. Vectors are 768-d (pgvector column); Anthropic has no embedding API.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
# Empty = api.openai.com. Only set for a proxy that serves the OpenAI Responses API.
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Orchestration: router llm | keyword; guards full | prompt_only | off (experiment baselines).
ROUTER_MODE=llm
GUARD_MODE=full
# Certification: red-team and benign cases per run, cases run in parallel.
CERTIFY_REDTEAM_CASES=30
CERTIFY_BENIGN_CASES=6
CERTIFY_CONCURRENCY=4
# Tracing (Langfuse): off while either key is empty. Keys from Langfuse > Project settings > API keys.
# Empty base URL = Langfuse Cloud EU; https://us.cloud.langfuse.com for US, http://localhost:3000 when self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=1.0
# Agent runtime: langgraph (built-in graph) | dify (self-hosted Dify, see infra/dify/README.md).
RUNTIME_ENGINE=langgraph
# Dify API base (nginx of the Dify compose stack, moved to 127.0.0.1:8080).
DIFY_BASE_URL=http://127.0.0.1:8080
# API keys of the three Dify apps (Dify > app > API Access) and the Knowledge API key.
DIFY_TRIAGE_KEY=
DIFY_RUNNER_KEY=
DIFY_RUNNER_RAW_KEY=
DIFY_DATASET_KEY=
# Seconds before a Dify call counts as failed (the turn ends with an error, nothing is let through).
DIFY_TIMEOUT_S=30
# Bearer token Dify sends to the backend MCP endpoint; any long random string.
MCP_TOKEN=
# How Dify's containers reach the backend MCP endpoint.
MCP_PUBLIC_URL=http://host.docker.internal:8001/mcp
