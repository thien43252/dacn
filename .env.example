# Copy to .env at the repo root. Never commit .env.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://eduagent:eduagent@127.0.0.1:5433/eduagent
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SESSION_HOURS=12
COOKIE_SECURE=false

# LLM adapter for what runs in the backend, not in Dify: certification judge, quiz_generator, rubric_grader,
# parent reports. openai | anthropic | gemini | fake (fake = offline, deterministic; used by tests)
# Anthropic defaults when the model names are empty: claude-opus-5-5 (main) / claude-haiku-5-5 (small).
# OpenAI and Gemini need both model names set.
LLM_PROVIDER=fake
LLM_MAIN_MODEL=
LLM_SMALL_MODEL=
LLM_EFFORT=medium
# Empty = api.openai.com. Only set for a proxy that serves the OpenAI Responses API.
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Certification: red-team and benign cases per run, cases run in parallel.
CERTIFY_REDTEAM_CASES=30
CERTIFY_BENIGN_CASES=6
CERTIFY_CONCURRENCY=4
# Tracing (Langfuse): off while either key is empty. Keys from Langfuse > Project settings > API keys.
# Empty base URL = Langfuse Cloud EU; https://us.cloud.langfuse.com for US, http://localhost:3000 when self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=1.0
# Lõi agent: dify (Dify tự dựng, xem infra/dify/README.md). Chỉ còn một giá trị.
RUNTIME_ENGINE=dify
# Địa chỉ API của Dify (nginx của bộ compose Dify, đã đổi sang 127.0.0.1:8080).
DIFY_BASE_URL=http://127.0.0.1:8080
# Khóa API của ứng dụng eduagent-triage (Dify > ứng dụng > API Access).
DIFY_TRIAGE_KEY=
# Khóa API của ứng dụng eduagent-runner (chat của người dùng).
DIFY_RUNNER_KEY=
# Khóa API của eduagent-runner-raw (tắt kiểm duyệt; chỉ dùng cho kiểm định).
DIFY_RUNNER_RAW_KEY=
# Khóa Knowledge API của Dify (kho tri thức từng lớp).
DIFY_DATASET_KEY=
# Khóa API của app eduagent-review (kiểm tra câu trả lời theo chính sách lớp); để trống thì bỏ qua bước này.
DIFY_REVIEW_KEY=
# Khóa API của app eduagent-planner (lập kế hoạch cho yêu cầu nhiều bước, feature 002); để trống thì mọi lượt
# chat đi đường nhanh (một agent trả lời như trước).
DIFY_PLANNER_KEY=
# Số giây chờ Dify; quá hạn thì lượt chat báo lỗi, không cho tin nhắn đi qua.
DIFY_TIMEOUT_S=30
# Model mà triage và runner dùng trong Dify (Dify không báo tên model); dùng để ghi và tính chi phí.
DIFY_TRIAGE_MODEL=gpt-4o-mini
DIFY_RUNNER_MODEL=gpt-4o-mini
# Mã bearer Dify gửi khi gọi MCP của backend; chuỗi ngẫu nhiên dài.
MCP_TOKEN=
# Địa chỉ container Dify dùng để gọi MCP của backend.
MCP_PUBLIC_URL=http://host.docker.internal:8001/mcp

# ---- Xử lý nhiều bước (feature 002); các giá trị dưới đây là mặc định, chỉ cần đặt khi muốn đổi ----
# Số lần tối đa dừng để hỏi lại người dùng trong một lượt.
ORCH_MAX_CLARIFY_ROUNDS=1
# Số câu hỏi tối đa mỗi lần hỏi lại.
ORCH_MAX_QUESTIONS=3
# Số phần việc tối đa mỗi lượt.
ORCH_MAX_STEPS=5
# Số agent tối đa tham gia một lượt (tính cả agent chính).
ORCH_MAX_AGENTS=3
# Số lần tối đa lập lại kế hoạch khi agent nhờ agent khác.
ORCH_MAX_REPLANS=1
# Số giây tối đa cho một phần việc.
ORCH_STEP_TIMEOUT_S=60
# Số giây tối đa cho cả lượt (chốt an toàn để lượt không chạy mãi).
ORCH_DEADLINE_S=120
# Số giờ câu hỏi đang chờ người dùng trả lời còn hiệu lực.
ORCH_PENDING_TTL_H=24
# Số giây chờ kiểm duyệt nội dung giáo viên chia sẻ (quá giờ thì không đề nghị xác nhận).
ORCH_SHARE_REVIEW_TIMEOUT_S=20
# Bật tool thử confirm_probe (chỉ cho test và eval, không bật khi demo).
ENABLE_TEST_TOOLS=false
