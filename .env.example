# Copy to .env at the repo root. Never commit .env.

APP_ENV=local
DATABASE_URL=postgresql+asyncpg://eduagent:eduagent@127.0.0.1:5433/eduagent
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SESSION_HOURS=12
COOKIE_SECURE=false

# LLM adapter: openai | anthropic | gemini | fake (fake = offline, deterministic; used by tests)
LLM_PROVIDER=fake
LLM_MAIN_MODEL=
LLM_SMALL_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
